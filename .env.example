# Optional API keys. This file is a TEMPLATE and is safe to share: it contains no keys.
#
# 1. Copy this file and name the copy ".env" (same folder).
# 2. Paste your key after the "=" in .env, with no spaces or quotes.
# 3. Never put a key in this file or in any .py file. ".env" is listed in .gitignore,
#    so Git will never upload it to GitHub.
#
# Everything works without keys; they only switch on extra checks.

# Free key: see "Turning on Google Safe Browsing" in README.md
GOOGLE_SAFE_BROWSING_KEY=

# Needs a Google Cloud billing account: https://developers.google.com/maps/documentation/places/web-service/text-search
GOOGLE_PLACES_KEY=

# Optional AI briefings (Google Gemini). See "Getting a Gemini API key" in README.md.
GEMINI_API_KEY=

# Claude Haiku 5.5 for the ATHAR Assistant's chat (console.anthropic.com > API keys). Paste the key after the = sign, no spaces or quotes:
ANTHROPIC_API_KEY=

# urlscan.io, to check flagged sites safely from screenshots (tools/verify_sites.py; urlscan.io > Settings & API > API Keys):
URLSCAN_API_KEY=
